@host = http://localhost:3001

### get all
GET {{host}}/api/persons

### get person
GET {{host}}/api/persons/1

### get missing person -> 404
GET {{host}}/api/persons/1000

### delete person -> 204
DELETE {{host}}/api/persons/1

### post person
POST {{host}}/api/persons
Content-Type: application/json
{
  "id": "5",
  "name": "Jane Doe",
  "number": "12-34-56789012"
}

### post person (missing name) -> 400
POST {{host}}/api/persons
Content-Type: application/json
{
  "id": "5",
  "number": "12-34-56789012"
}

### post person (missing number) -> 400
POST {{host}}/api/persons
Content-Type: application/json
{
  "id": "5",
  "name": "Jane Doe"
}

### post person (same name) -> 409
POST {{host}}/api/persons
Content-Type: application/json
{
  "id": "5",
  "name": "Arto Hellas",
  "number": "040-234567"
}
